[Unit]
Description=Titan camera HTTP image receiver
After=network.target

[Service]
Type=simple
User=ztl
WorkingDirectory=/home/ztl/Desktop/lorry
ExecStart=/usr/bin/python3 -u /home/ztl/Desktop/lorry/receive_face_http.py --host 0.0.0.0 --port 5000 --out /home/ztl/Desktop/lorry/captures_http
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
